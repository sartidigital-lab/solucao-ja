# ─── CONFIGURAÇÕES DO SUPABASE (PRODUÇÃO) ─────────────────────────────────
# URL do projeto em produção (ex: https://abcde.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima pública do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── CONFIGURAÇÕES DA APLICAÇÃO ──────────────────────────────────────────
# URL principal do PWA implantado em produção (ex: https://app.solucaoja.com.br)
NEXT_PUBLIC_APP_URL=

# ─── GOOGLE MAPS PLATFORM ────────────────────────────────────────────────
# Chave pública para renderização do Mapa JavaScript no navegador (Client-side)
# Recomenda-se restringir esta chave por referer HTTP no console do Google Cloud para o domínio de produção.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Chave privada para Geocoding API e Places API no servidor (Server-side)
# Esta chave deve possuir permissão para realizar requisições de backend para geolocalização.
GOOGLE_MAPS_API_KEY=

# ─── MERCADO PAGO SDK (PAGAMENTOS PIX) ───────────────────────────────────
# Chave pública do Mercado Pago (obtida em Credenciais de Produção/Testes)
MERCADO_PAGO_PUBLIC_KEY=

# Access Token do Mercado Pago (obtido em Credenciais de Produção/Testes)
MERCADO_PAGO_ACCESS_TOKEN=

# Segredo de assinatura configurado no painel de Webhooks do Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET=

# Usada somente no servidor, por webhooks e notificações confiáveis. Nunca
# exponha esta chave em variáveis NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# ─── WHATSAPP CLOUD API (META DEVELOPERS) ────────────────────────────────
# Token de acesso permanente gerado no Facebook Developer Console para o app de mensagens
WHATSAPP_API_TOKEN=

# ID do número de telefone cadastrado e verificado no painel da Meta Developers
WHATSAPP_PHONE_NUMBER_ID=
